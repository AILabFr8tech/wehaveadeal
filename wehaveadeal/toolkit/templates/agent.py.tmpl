"""$class_name -- a We Have a Deal $role agent.

Generated by `wehaveadeal new-agent`. It already plays legally (a simple
time-based concession strategy), so you can benchmark it right away:

    wehaveadeal validate $file_name
    wehaveadeal benchmark $file_name --preset quick

then replace the strategy in `next_move` with your own. Everything your agent
may know is in `state` (a TableState) -- see docs/WRITING_AN_AGENT.md.

Bring your own compute: if your agent calls an LLM API or a model server,
it runs on YOUR key / YOUR machine. Nothing here talks to any server of ours.
"""
from wehaveadeal import ACCEPT, REJECT, DecisionEngine, Move, TableState, legal_offer_range, offer


class $class_name(DecisionEngine):
    role = "$role"  # "carrier" (sells transport) or "shipper" (buys it)
    engine_name = "$class_name"
    version = "v1"

    def __init__(self, agent_id: str, frozen: bool = True, toughness: float = 1.5) -> None:
        super().__init__(agent_id, frozen=frozen)
        self.toughness = toughness  # >1 concedes late (Boulware), <1 concedes early (Conceder)

    def next_move(self, state: TableState) -> Move:
        lo, hi = legal_offer_range(state)
        # Fraction of my own turns already spent, 0 -> 1.
        progress = state.my_turns_used / max(1, state.turns_per_side - 1)
        concession = min(1.0, progress) ** self.toughness

        if state.role == "carrier":
            # Carriers want a HIGH rate: start at the top of the band, concede downwards.
            band_lo = state.refprice_mean - 0.5 * state.sigma
            band_hi = state.refprice_mean + 0.5 * state.sigma
            target = band_hi - concession * (band_hi - band_lo)
            if state.opp_last_offer is not None and state.opp_last_offer >= target:
                return ACCEPT
        else:
            # Shippers want a LOW rate: open below their estimate, concede upwards to the reservation price.
            reservation = state.sale_price - state.goods_cost
            opening = min(reservation, state.refprice_est - 0.5 * state.sigma)
            target = opening + concession * (reservation - opening)
            if state.opp_last_offer is not None and state.opp_last_offer <= target:
                return ACCEPT

        if lo > hi:  # no legal offer left
            return REJECT
        return offer(min(max(target, lo), hi))
